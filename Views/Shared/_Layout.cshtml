<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Sistema Monitoreo Redes</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="d-flex" id="wrapper">
    <!-- SIDEBAR -->
    <nav id="sidebar" class="sidebar d-flex flex-column">
        <div class="sidebar-brand">
            <i class="bi bi-router me-2"></i>
            <span>NetMonitor</span>
        </div>
        <ul class="nav flex-column px-2 flex-grow-1">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alertas" ? "active" : "")"
                   asp-controller="Alertas" asp-action="Index">
                    <i class="bi bi-bell me-2"></i> Alertas
                    <span id="sidebarAlertaBadge" class="badge bg-danger ms-auto sidebar-badge" style="display:none">0</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoreo" ? "active" : "")"
                   asp-controller="Monitoreo" asp-action="Index">
                    <i class="bi bi-activity me-2"></i> Monitoreo
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Crud" ? "active" : "")"
                   asp-controller="Crud" asp-action="Index">
                    <i class="bi bi-table me-2"></i> Gestión de Datos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")"
                   asp-controller="Reportes" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i> Reportes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ia" ? "active" : "")"
                   asp-controller="Ia" asp-action="Index">
                    <i class="bi bi-robot me-2"></i> Inteligencia Artificial
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chatbot" ? "active" : "")"
                   asp-controller="Chatbot" asp-action="Index">
                    <i class="bi bi-chat-dots me-2"></i> Chatbot
                </a>
            </li>
        </ul>
        <div class="sidebar-footer px-3 py-3">
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm w-100">
                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
            </a>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <div id="page-content" class="flex-grow-1 d-flex flex-column">
        <!-- NAVBAR -->
        <nav class="navbar top-navbar px-3">
            <button class="btn btn-sm btn-link text-dark" id="sidebarToggle">
                <i class="bi bi-list fs-4"></i>
            </button>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <!-- Campana de alertas -->
                <a asp-controller="Alertas" asp-action="Index" class="position-relative text-decoration-none text-dark bell-btn" title="Alertas pendientes">
                    <i class="bi bi-bell fs-5"></i>
                    <span id="bellBadge"
                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                          style="display:none; font-size:.65rem; min-width:18px; min-height:18px; align-items:center; justify-content:center;">0</span>
                </a>
                <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Online</span>
                <span class="fw-semibold text-muted small"><i class="bi bi-person-circle me-1"></i>admin</span>
            </div>
        </nav>

        <!-- MAIN -->
        <main class="main-content flex-grow-1 p-4">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="text-center text-muted small py-2 border-top bg-white">
            &copy; @DateTime.Now.Year – Sistema Inteligente de Gestión y Monitoreo de Redes
        </footer>
    </div>
</div>

<!-- Toast container global -->
<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
// ── Badge campana global: conectar a hub y actualizar al cargar ───
(function initAlertaBadge() {
    // Cargar contador actual al iniciar la página
    fetch('/Alertas/ContadorPendientes')
        .then(r => r.json())
        .then(d => actualizarBadgeCampanaGlobal(d.count))
        .catch(() => {});

    // Escuchar actualizaciones en tiempo real
    const conn = new signalR.HubConnectionBuilder()
        .withUrl('/alertasHub')
        .withAutomaticReconnect()
        .build();

    conn.on('ActualizarContadorAlertas', function(n) {
        actualizarBadgeCampanaGlobal(n);
    });

    conn.on('NuevaAlerta', function(alerta) {
        // Solo mostrar toast si no estamos en la página de alertas
        if (!window.location.pathname.toLowerCase().includes('/alertas')) {
            mostrarToastGlobal(alerta);
        }
        if (alerta.severidad === 'Crítica') reproducirBeepGlobal();
    });

    conn.start().catch(() => {});

    window._alertasConn = conn;
})();

function actualizarBadgeCampanaGlobal(n) {
    const badge = document.getElementById('bellBadge');
    const sbBadge = document.getElementById('sidebarAlertaBadge');
    if (badge) {
        badge.textContent = n > 99 ? '99+' : n;
        badge.style.display = n > 0 ? 'inline-flex' : 'none';
    }
    if (sbBadge) {
        sbBadge.textContent = n > 99 ? '99+' : n;
        sbBadge.style.display = n > 0 ? 'inline' : 'none';
    }
}

function mostrarToastGlobal(alerta) {
    const colorMap = { 'Crítica': 'danger', 'Alta': 'warning', 'Media': 'info', 'Baja': 'secondary' };
    const color = colorMap[alerta.severidad] || 'secondary';
    const t = document.createElement('div');
    t.className = `toast align-items-center text-bg-${color} border-0`;
    t.setAttribute('role', 'alert');
    t.innerHTML = `<div class="d-flex">
        <div class="toast-body">
            <strong><i class="bi bi-bell-fill me-1"></i>${alerta.tipoAlerta}</strong><br>
            <small>${alerta.dispositivo || ''} ${alerta.ip ? '(' + alerta.ip + ')' : ''}</small>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>`;
    document.getElementById('toastContainer').appendChild(t);
    bootstrap.Toast.getOrCreateInstance(t, { delay: 6000 }).show();
    t.addEventListener('hidden.bs.toast', () => t.remove());
}

function reproducirBeepGlobal() {
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'square';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.setValueAtTime(440, ctx.currentTime + 0.1);
        osc.frequency.setValueAtTime(880, ctx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.4);
    } catch(e) {}
}
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
