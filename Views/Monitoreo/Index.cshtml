@{
    ViewData["Title"] = "Monitoreo en Tiempo Real";
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="page-title"><i class="bi bi-activity me-2"></i>Monitoreo en Tiempo Real</h2>
        <p class="text-muted mb-0">Actualización automática cada 10 segundos</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span id="statusBadge" class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Activo</span>
        <span class="text-muted small">Última actualización: <span id="ultimaActualizacion">—</span></span>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaMonitoreo">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Dispositivo</th>
                        <th>Tipo</th>
                        <th>IP</th>
                        <th>Estado</th>
                        <th>CPU %</th>
                        <th>RAM %</th>
                        <th>↓ Mbps</th>
                        <th>↑ Mbps</th>
                        <th>Latencia</th>
                        <th>Alerta</th>
                        <th>Incidencia</th>
                        <th>Riesgo IA</th>
                    </tr>
                </thead>
                <tbody id="tbodyMonitoreo">
                    <tr><td colspan="13" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
function estadoBadge(estado) {
    const map = { 'Activo': 'success', 'Advertencia': 'warning', 'Falla': 'danger' };
    const cls = map[estado] || 'secondary';
    return `<span class="badge bg-${cls}">${estado ?? '—'}</span>`;
}
function riesgoBadge(r) {
    const map = { 'Alto': 'danger', 'Medio': 'warning', 'Bajo': 'success' };
    const cls = map[r] || 'secondary';
    return r ? `<span class="badge bg-${cls}">${r}</span>` : '—';
}
function cpuBar(val) {
    const cls = val >= 90 ? 'danger' : val >= 70 ? 'warning' : 'success';
    return `<div class="d-flex align-items-center gap-1"><div class="progress flex-grow-1" style="height:6px;min-width:40px"><div class="progress-bar bg-${cls}" style="width:${val}%"></div></div><small>${val}%</small></div>`;
}

function cargarDatos() {
    $.getJSON('/Monitoreo/GetDatosMonitoreo', function(data) {
        const tbody = $('#tbodyMonitoreo');
        tbody.empty();
        if (!data.length) {
            tbody.append('<tr><td colspan="13" class="text-center text-muted py-4">Sin datos disponibles</td></tr>');
            return;
        }
        data.forEach(r => {
            tbody.append(`<tr>
                <td class="small text-muted">${r.fechaHora}</td>
                <td class="fw-semibold">${r.nombreDispositivo ?? '—'}</td>
                <td><span class="badge bg-light text-dark border">${r.tipo ?? '—'}</span></td>
                <td class="font-monospace small">${r.ip ?? '—'}</td>
                <td>${estadoBadge(r.estado)}</td>
                <td>${cpuBar(r.cpu)}</td>
                <td>${cpuBar(r.ram)}</td>
                <td>${r.descarga}</td>
                <td>${r.subida}</td>
                <td><span class="${r.latencia > 50 ? 'text-danger fw-bold' : ''}">${r.latencia} ms</span></td>
                <td class="small">${r.alerta ?? '—'}</td>
                <td class="small">${r.incidencia ?? '—'}</td>
                <td>${riesgoBadge(r.riesgoIa)}</td>
            </tr>`);
        });
        $('#ultimaActualizacion').text(new Date().toLocaleTimeString('es-PE'));
    });
}

cargarDatos();
setInterval(cargarDatos, 10000);
</script>
}
