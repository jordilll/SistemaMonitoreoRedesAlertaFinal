@model CrudViewModel
@{
    ViewData["Title"] = "Gestión de Datos";
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="page-title"><i class="bi bi-table me-2"></i>Gestión de Datos</h2>
        <p class="text-muted mb-0">@Model.TotalRegistros registro(s) encontrado(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo Registro</a>
</div>

<!-- Filtros -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="🔍 Búsqueda general..." />
            </div>
            <div class="col-md-2">
                <select name="filtroEstado" class="form-select">
                    <option value="">— Estado —</option>
                    @foreach (var e in Model.Estados)
                    { <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="filtroTipo" class="form-select">
                    <option value="">— Tipo —</option>
                    @foreach (var t in Model.Tipos)
                    { <option value="@t" selected="@(Model.FiltroTipo == t)">@t</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="filtroMarca" class="form-select">
                    <option value="">— Marca —</option>
                    @foreach (var m in Model.Marcas)
                    { <option value="@m" selected="@(Model.FiltroMarca == m)">@m</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="filtroUbicacion" class="form-select">
                    <option value="">— Ubicación —</option>
                    @foreach (var u in Model.Ubicaciones)
                    { <option value="@u" selected="@(Model.FiltroUbicacion == u)">@u</option> }
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th><a asp-action="Index" asp-route-orden="@(Model.Orden == "fecha" ? "fecha_desc" : "fecha")" class="text-white text-decoration-none">Fecha <i class="bi bi-arrow-down-up"></i></a></th>
                        <th><a asp-action="Index" asp-route-orden="@(Model.Orden == "nombre" ? "nombre_desc" : "nombre")" class="text-white text-decoration-none">Dispositivo <i class="bi bi-arrow-down-up"></i></a></th>
                        <th>Tipo</th>
                        <th>IP</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th><a asp-action="Index" asp-route-orden="cpu" class="text-white text-decoration-none">CPU% <i class="bi bi-arrow-down-up"></i></a></th>
                        <th><a asp-action="Index" asp-route-orden="ram" class="text-white text-decoration-none">RAM% <i class="bi bi-arrow-down-up"></i></a></th>
                        <th><a asp-action="Index" asp-route-orden="latencia" class="text-white text-decoration-none">Latencia <i class="bi bi-arrow-down-up"></i></a></th>
                        <th>Riesgo IA</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Registros.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No se encontraron registros.</td></tr>
                    }
                    @foreach (var r in Model.Registros)
                    {
                        <tr>
                            <td class="small text-muted">@r.FechaHora?.ToString("dd/MM/yy HH:mm")</td>
                            <td class="fw-semibold">@r.NombreDispositivo</td>
                            <td><span class="badge bg-light text-dark border">@r.Tipo</span></td>
                            <td class="font-monospace small">@r.Ip</td>
                            <td>@r.Ubicacion</td>
                            <td>
                                @{
                                    var cls = r.Estado switch { "Activo" => "success", "Advertencia" => "warning", "Falla" => "danger", _ => "secondary" };
                                }
                                <span class="badge bg-@cls">@r.Estado</span>
                            </td>
                            <td class="@(r.CpuPorcentaje > 90 ? "text-danger fw-bold" : "")">@r.CpuPorcentaje%</td>
                            <td class="@(r.RamPorcentaje > 90 ? "text-danger fw-bold" : "")">@r.RamPorcentaje%</td>
                            <td class="@(r.LatenciaMs > 50 ? "text-danger fw-bold" : "")">@r.LatenciaMs ms</td>
                            <td>
                                @{
                                    var rc = r.RiesgoIa switch { "Alto" => "danger", "Medio" => "warning", "Bajo" => "success", _ => "secondary" };
                                }
                                @if (r.RiesgoIa != null)
                                { <span class="badge bg-@rc">@r.RiesgoIa</span> }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@r.IdMonitoreo" class="btn btn-outline-info" title="Ver"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@r.IdMonitoreo" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger" title="Eliminar" onclick="confirmarEliminar(@r.IdMonitoreo, '@r.NombreDispositivo')"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación -->
@if (Model.TotalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)"
                   asp-route-busqueda="@Model.Busqueda" asp-route-filtroEstado="@Model.FiltroEstado"
                   asp-route-filtroTipo="@Model.FiltroTipo" asp-route-filtroMarca="@Model.FiltroMarca"
                   asp-route-filtroUbicacion="@Model.FiltroUbicacion">«</a>
            </li>
            @for (int i = Math.Max(1, Model.PaginaActual - 2); i <= Math.Min(Model.TotalPaginas, Model.PaginaActual + 2); i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i"
                       asp-route-busqueda="@Model.Busqueda" asp-route-filtroEstado="@Model.FiltroEstado"
                       asp-route-filtroTipo="@Model.FiltroTipo" asp-route-filtroMarca="@Model.FiltroMarca"
                       asp-route-filtroUbicacion="@Model.FiltroUbicacion">@i</a>
                </li>
            }
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)"
                   asp-route-busqueda="@Model.Busqueda" asp-route-filtroEstado="@Model.FiltroEstado"
                   asp-route-filtroTipo="@Model.FiltroTipo" asp-route-filtroMarca="@Model.FiltroMarca"
                   asp-route-filtroUbicacion="@Model.FiltroUbicacion">»</a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Confirmar Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-trash me-2"></i>Confirmar Eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de eliminar el registro de <strong id="nombreDispositivo"></strong>? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminar" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmarEliminar(id, nombre) {
    document.getElementById('nombreDispositivo').textContent = nombre;
    document.getElementById('formEliminar').action = '/Crud/Delete/' + id;
    new bootstrap.Modal(document.getElementById('modalEliminar')).show();
}
</script>
}
