@model Red
@{
    ViewData["Title"] = "Editar Registro";
}

<div class="page-header mb-4">
    <h2 class="page-title"><i class="bi bi-pencil me-2"></i>Editar Registro #@Model.IdMonitoreo</h2>
</div>

<div class="card shadow-sm border-0 mx-auto" style="max-width:900px">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdMonitoreo" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FechaHora" class="form-label fw-semibold"></label>
                    <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="IdDispositivo" class="form-label fw-semibold"></label>
                    <input asp-for="IdDispositivo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="NombreDispositivo" class="form-label fw-semibold"></label>
                    <input asp-for="NombreDispositivo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label fw-semibold"></label>
                    <input asp-for="Tipo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Marca" class="form-label fw-semibold"></label>
                    <input asp-for="Marca" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Modelo" class="form-label fw-semibold"></label>
                    <input asp-for="Modelo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Ip" class="form-label fw-semibold"></label>
                    <input asp-for="Ip" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Ubicacion" class="form-label fw-semibold"></label>
                    <input asp-for="Ubicacion" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Estado" class="form-label fw-semibold"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="">— Seleccionar —</option>
                        <option>Activo</option>
                        <option>Advertencia</option>
                        <option>Falla</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="CpuPorcentaje" class="form-label fw-semibold"></label>
                    <input asp-for="CpuPorcentaje" type="number" step="0.1" min="0" max="100" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="RamPorcentaje" class="form-label fw-semibold"></label>
                    <input asp-for="RamPorcentaje" type="number" step="0.1" min="0" max="100" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DescargaMbps" class="form-label fw-semibold"></label>
                    <input asp-for="DescargaMbps" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SubidaMbps" class="form-label fw-semibold"></label>
                    <input asp-for="SubidaMbps" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="LatenciaMs" class="form-label fw-semibold"></label>
                    <input asp-for="LatenciaMs" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Alerta" class="form-label fw-semibold"></label>
                    <input asp-for="Alerta" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Incidencia" class="form-label fw-semibold"></label>
                    <input asp-for="Incidencia" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="RiesgoIa" class="form-label fw-semibold"></label>
                    <select asp-for="RiesgoIa" class="form-select">
                        <option value="">— Seleccionar —</option>
                        <option>Bajo</option>
                        <option>Medio</option>
                        <option>Alto</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="RecomendacionIa" class="form-label fw-semibold"></label>
                    <textarea asp-for="RecomendacionIa" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12 d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Actualizar</button>
                </div>
            </div>
        </form>
    </div>
</div>
